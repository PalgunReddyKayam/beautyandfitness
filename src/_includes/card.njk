{% set colors = {"skincare":"rose","hair":"plum","strength":"fern","recovery":"fern","mobility":"fern","nutrition":"gold","mindset":"plum"} %}
{% set c = colors[post.data.category | lower] or ("rose" if post.data.pillar == "beauty" else "fern") %}
{% set t = "rose" if post.data.pillar == "beauty" else ("gold" if post.data.category == "Nutrition" else "fern") %}
<article class="card">
  <a href="{{ post.url }}" class="cover cover-{{ c }}" aria-hidden="true" tabindex="-1">
    {% if post.data.cover %}<img src="{{ post.data.cover }}" alt="" style="width:100%;height:100%;object-fit:cover">{% else %}<div class="glyph"></div>{% endif %}
  </a>
  <div class="body">
    <div class="meta"><span class="tag tag-{{ t }}">{{ post.data.category }}</span><span>{{ post.templateContent | readTime }}</span></div>
    <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p>{{ post.data.summary }}</p>
    <a class="read" href="{{ post.url }}">Read the article</a>
  </div>
</article>
